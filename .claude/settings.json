{
  "extraKnownMarketplaces": {
    "tokeneconomizer": {
      "source": {
        "source": "github",
        "repo": "microsoft/TokenEconomizer"
      }
    }
  },
  "enabledPlugins": {
    "tokeneconomizer@tokeneconomizer": true
  },
  "env": {
    "TOKENECONOMIZER_HOME": ".tokeneconomizer"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "g=$(command -v graphify 2>/dev/null || echo \"$HOME/.local/bin/graphify\"); [ -x \"$g\" ] || exit 0; exec \"$g\" hook-guard search",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "g=$(command -v graphify 2>/dev/null || echo \"$HOME/.local/bin/graphify\"); [ -x \"$g\" ] || exit 0; exec \"$g\" hook-guard read",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "g=$(command -v graphify 2>/dev/null || echo \"$HOME/.local/bin/graphify\"); [ -x \"$g\" ] || exit 0; exec \"$g\" hook-guard compact",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
