{
  "name": "hearthside-life",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Hearthside Life - an original browser life simulation (Three.js, TypeScript, Vite).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "build:dist": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "assets": "node tools/build-assets.mjs",
    "assets:extra": "node tools/build-extra-furniture.mjs",
    "assets:surfaces": "node tools/build-surface-maps.mjs",
    "assets:meshy": "node --experimental-strip-types tools/build-meshy-bodies.mts",
    "assets:mpfb": "node --experimental-strip-types --no-warnings tools/build-mpfb-bodies.mts",
    "content:check": "node --experimental-strip-types tools/content-report.ts",
    "e2e": "node tests/e2e/run-e2e.mjs",
    "e2e:acceptance": "node tests/e2e/acceptance.mjs",
    "e2e:creator": "node tests/e2e/creator-m3.mjs",
    "visual:surfaces": "node dev/surfaces-sheet.mjs",
    "visual:m5": "node dev/ds-tasks/visual-m5.mjs",
    "visual:m11:careers": "node dev/ds-tasks/m11/shots-careers.mjs",
    "visual:m11:skills-c": "node dev/ds-tasks/m11/shoot-skills-c.mjs",
    "visual:m11:skills": "node dev/ds-tasks/m11/shots-skills-b.mjs",
    "visual:m11:traits": "node dev/ds-tasks/m11/shoot-d.mjs",
    "visual:m11:pond": "node dev/ds-tasks/m11/render-pond.mjs",
    "visual:m12:weather": "node dev/ds-tasks/m12/shoot-w.mjs",
    "visual:m12:pools": "node dev/ds-tasks/m12/p-shots.mjs",
    "dev:m115:inspect": "node dev/ds-tasks/m115/inspect-objects.mjs",
    "visual:m115:d": "node dev/ds-tasks/m115/shoot-d.mjs",
    "visual:m115:screens": "node dev/ds-tasks/m115/shoot-s.mjs",
    "visual:m115:b": "node dev/ds-tasks/m115/shoot-b.mjs",
    "visual:m115:h": "node dev/ds-tasks/m115/shoot-h.mjs",
    "visual:stages": "node dev/mpfb/shootStages.mjs",
    "visual:stages:compose": "node dev/mpfb/composeStages.mjs",
    "debug:creator": "node dev/ds-tasks/debug-creator.mjs",
    "debug:pixels": "node dev/ds-tasks/pixels.mjs",
    "hair:ai": "node --experimental-strip-types --no-warnings tools/build-ai-hair.mts"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@types/node": "22.20.5",
    "@types/three": "0.186.0",
    "fake-indexeddb": "6.2.7",
    "meshoptimizer": "1.3.0",
    "sharp": "0.35.5",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  }
}
